+class DownloadDownloadIntegrityTestCase(TestCase):
+    @pytest.fixture(autouse=True)
+    def inject_fixtures(self) -> None:
+        self.root_path = path_from_project_root(__file__)
+
+    def test_short_temp_file_is_not_promoted(self) -> None:
+        temp_dir = os.path.join(self.root_path, "tmp-download-integrity")
+        recreate_path(temp_dir)
+        temp_path = os.path.join(temp_dir, "abc.part")
+        final_path = os.path.join(temp_dir, "final.jpg")
+        with open(temp_path, "wb") as handle:
+            handle.write(b"12345")
+        version = mock.MagicMock()
+        version.size = 10
+        version.checksum = "MQ=="
+        with self.assertLogs("icloudpd", level="WARNING") as logs:
+            result = download.finalize_download_path(
+                logging.getLogger("icloudpd"),
+                temp_path,
+                final_path,
+                version,
+                datetime.datetime.now(datetime.timezone.utc),
+                False,
+            )
+        self.assertFalse(result)
+        self.assertTrue(os.path.exists(temp_path))
+        self.assertFalse(os.path.exists(final_path))
+        self.assertTrue(any("truncated" in line for line in logs.output))
+
+    def test_oversize_temp_file_is_moved_aside(self) -> None:
+        temp_dir = os.path.join(self.root_path, "tmp-download-integrity")
+        recreate_path(temp_dir)
+        temp_path = os.path.join(temp_dir, "abc.part")
+        final_path = os.path.join(temp_dir, "final.jpg")
+        with open(temp_path, "wb") as handle:
+            handle.write(b"12345")
+        version = mock.MagicMock()
+        version.size = 3
+        with self.assertLogs("icloudpd", level="ERROR") as logs:
+            result = download.finalize_download_path(
+                logging.getLogger("icloudpd"),
+                temp_path,
+                final_path,
+                version,
+                datetime.datetime.now(datetime.timezone.utc),
+                False,
+            )
+        self.assertFalse(result)
+        self.assertFalse(os.path.exists(temp_path))
+        self.assertFalse(os.path.exists(final_path))
+        self.assertEqual(len([name for name in os.listdir(temp_dir) if ".oversize." in name]), 1)
+        self.assertTrue(any("larger than expected" in line for line in logs.output))
+
+    def test_replacement_uses_same_directory_staging_and_quarantines_backup(self) -> None:
+        temp_dir = os.path.join(self.root_path, "tmp-download-integrity")
+        recreate_path(temp_dir)
+        library_dir = os.path.join(temp_dir, "library")
+        media_dir = os.path.join(library_dir, "2024", "03")
+        quarantine_dir = os.path.join(temp_dir, "quarantine")
+        staging_dir = os.path.join(media_dir, ".icloudpd-repair-staging-test")
+        os.makedirs(staging_dir, exist_ok=True)
+        os.makedirs(quarantine_dir, exist_ok=True)
+        source_path = os.path.join(media_dir, "source.mp4")
+        staging_path = os.path.join(staging_dir, "source.mp4")
+        with open(source_path, "wb") as handle:
+            handle.write(b"old")
+        with open(staging_path, "wb") as handle:
+            handle.write(b"new")
+
+        result = base._replace_from_staged_download(
+            logging.getLogger("icloudpd"),
+            source_path,
+            staging_path,
+            quarantine_dir,
+            library_dir,
+        )
+
+        self.assertTrue(result)
+        with open(source_path, "rb") as handle:
+            self.assertEqual(handle.read(), b"new")
+        self.assertFalse(os.path.exists(staging_dir))
+        quarantined_dir = os.path.join(quarantine_dir, "2024", "03")
+        self.assertEqual(len(os.listdir(quarantined_dir)), 1)
+        quarantined_path = os.path.join(quarantined_dir, os.listdir(quarantined_dir)[0])
+        with open(quarantined_path, "rb") as handle:
+            self.assertEqual(handle.read(), b"old")
+
